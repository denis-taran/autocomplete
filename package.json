{
    "name": "autocompleter",
    "version": "10.0.0",
    "type": "module",
    "description": "Blazing fast and lightweight autocomplete library without dependencies. 1KB gzipped.",
    "main": "autocomplete.cjs",
    "module": "autocomplete.mjs",
    "style": "autocomplete.css",
    "types": "./autocomplete.d.ts",
    "exports": {
        ".": {
            "types": "./autocomplete.d.ts",
            "import": "./autocomplete.mjs",
            "require": "./autocomplete.cjs",
            "default": "./autocomplete.mjs"
        },
        "./package.json": "./package.json",
        "./autocomplete.css": "./autocomplete.css"
    },
    "scripts": {
        "lint": "eslint autocomplete.ts",
        "build:js": "rollup -c rollup.config.mjs",
        "build:css": "node ./node_modules/clean-css-cli/bin/cleancss ./autocomplete.css -o ./autocomplete.min.css",
        "build": "npm run build:js && npm run build:css"
    },
    "author": "Denis Taran",
    "license": "MIT",
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@rollup/plugin-terser": "1.0.0",
        "@rollup/plugin-typescript": "12.3.0",
        "clean-css-cli": "4.3.0",
        "eslint": "10.7.0",
        "rollup": "4.62.2",
        "tslib": "2.8.1",
        "typescript": "5.9.3",
        "typescript-eslint": "8.64.0"
    },
    "homepage": "https://smartscheduling.com/en/documentation/autocomplete",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/denis-taran/autocomplete.git"
    },
    "bugs": {
        "url": "https://github.com/denis-taran/autocomplete/issues"
    },
    "keywords": [
        "ajax",
        "auto-complete",
        "autocomplete",
        "autocompleter",
        "best",
        "categories",
        "category",
        "collapse",
        "combo box",
        "complete",
        "component",
        "dropdown",
        "fast",
        "form",
        "group",
        "grouping",
        "groups",
        "input",
        "javascript",
        "library",
        "lightweight",
        "list",
        "small",
        "suggester",
        "tiny",
        "typescript",
        "ui",
        "vanilla-js",
        "vanilla",
        "widget"
    ]
}
